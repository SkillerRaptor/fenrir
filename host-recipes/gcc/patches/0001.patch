diff --git a/gcc/config.gcc b/gcc/config.gcc
index 039fa4694ad..fbed2fd0c5d 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -825,6 +825,13 @@ case ${target} in
   rust_target_objs="${rust_target_objs} dragonfly-rust.o"
   target_has_targetrustm=yes
   ;;
+*-*-fenrir*)
+  extra_options="$extra_options gnu-user.opt"
+  gas=yes
+  gnu_ld=yes
+  default_use_cxa_atexit=yes
+  use_gcc_stdint=provide
+  ;;
 *-*-freebsd*)
   # This is the generic ELF configuration of FreeBSD.  Later
   # machine-specific sections may refine and add to this
@@ -1189,6 +1196,9 @@ case ${target} in
 esac
 
 case ${target} in
+x86_64-*-fenrir*)
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h i386/i386elf.h i386/x86-64.h fenrir.h gnu-user.h"
+	;;
 aarch64*-*-elf | aarch64*-*-fuchsia* | aarch64*-*-rtems*)
 	tm_file="${tm_file} elfos.h newlib-stdint.h"
 	tm_file="${tm_file} aarch64/aarch64-elf.h aarch64/aarch64-errata.h aarch64/aarch64-elf-raw.h"
diff --git a/gcc/config/fenrir.h b/gcc/config/fenrir.h
new file mode 100644
index 00000000000..0f30ec30639
--- /dev/null
+++ b/gcc/config/fenrir.h
@@ -0,0 +1,19 @@
+#undef TARGET_FENRIR
+#define TARGET_FENRIR 1
+
+#undef LIB_SPEC
+#define LIB_SPEC "-lc"
+
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "crt0.o%s crti.o%s crtbegin.o%s"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()      \
+  do {                                \
+    builtin_define ("__fenrir__");      \
+    builtin_define ("__unix__");      \
+    builtin_assert ("system=fenrir");   \
+  } while(0);
diff --git a/libgcc/config.host b/libgcc/config.host
index ee10e99b0a6..3325556fe04 100644
--- a/libgcc/config.host
+++ b/libgcc/config.host
@@ -784,6 +784,10 @@ i[34567]86-*-openbsd*)
 	;;
 x86_64-*-openbsd*)
 	;;
+x86_64-*-fenrir*)
+	extra_parts="$extra_parts crti.o crtbegin.o crtend.o crtn.o"
+	tmake_file="$tmake_file i386/t-crtstuff t-crtstuff-pic t-libgcc-pic"
+	;;
 i[34567]86-*-linux*)
 	extra_parts="$extra_parts crtprec32.o crtprec64.o crtprec80.o crtfastmath.o"
 	tmake_file="${tmake_file} i386/t-crtpc t-crtfm i386/t-crtstuff t-dfprules"
diff --git a/libstdc++-v3/crossconfig.m4 b/libstdc++-v3/crossconfig.m4
index b3269cb88e0..97ea220db7f 100644
--- a/libstdc++-v3/crossconfig.m4
+++ b/libstdc++-v3/crossconfig.m4
@@ -9,6 +9,13 @@ case "${host}" in
     # This is a freestanding configuration; there is nothing to do here.
     ;;
 
+  *-fenrir*)
