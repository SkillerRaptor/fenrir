diff --git a/sysdeps/fenrir/include/fenrir/syscall.hpp b/sysdeps/fenrir/include/fenrir/syscall.hpp
new file mode 100644
index 00000000..5ee18204
--- /dev/null
+++ b/sysdeps/fenrir/include/fenrir/syscall.hpp
@@ -0,0 +1,124 @@
+#ifndef _MLIBC_SYSCALL_H
+#define _MLIBC_SYSCALL_H
+
+#include <stdint.h>
+
+inline int64_t syscall(uint64_t syscall_id) {
+	register int64_t return_value asm("rax") = 0;
+	register uint64_t _syscall_id asm("rax") = syscall_id;
+
+	asm volatile("syscall" : "=r"(return_value) : "r"(_syscall_id) : "memory");
+
+	return return_value;
+}
+
+template <typename Arg0>
+int64_t syscall(uint64_t syscall_id, Arg0 a0) {
+	register int64_t return_value asm("rax") = 0;
+	register uint64_t _syscall_id asm("rax") = syscall_id;
+	register uint64_t _argument_1 asm("rdi") = (uint64_t)a0;
+
+	asm volatile("syscall" : "=r"(return_value) : "r"(_syscall_id), "r"(_argument_1) : "memory");
+
+	return return_value;
+}
+
+template <typename Arg0, typename Arg1>
+int64_t syscall(uint64_t syscall_id, Arg0 a0, Arg1 a1) {
+	register int64_t return_value asm("rax") = 0;
+	register uint64_t _syscall_id asm("rax") = syscall_id;
+	register uint64_t _argument_1 asm("rdi") = (uint64_t)a0;
