diff --git a/sysdeps/fenrir/generic/entry.cpp b/sysdeps/fenrir/generic/entry.cpp
new file mode 100644
index 00000000..71cf340c
--- /dev/null
+++ b/sysdeps/fenrir/generic/entry.cpp
@@ -0,0 +1,21 @@
+/*
+ * Copyright (c) 2026-present, SkillerRaptor
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <mlibc/elf/startup.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+extern "C" void __dlapi_enter(uintptr_t *);
+
+extern char **environ;
+
+extern "C" void
+__mlibc_entry(uintptr_t *entry_stack, int (*main_fn)(int argc, char *argv[], char *env[])) {
+	__dlapi_enter(entry_stack);
+
+	auto result = main_fn(mlibc::entry_stack.argc, mlibc::entry_stack.argv, environ);
+	exit(result);
+}
diff --git a/sysdeps/fenrir/generic/sysdeps.cpp b/sysdeps/fenrir/generic/sysdeps.cpp
new file mode 100644
index 00000000..45d4054f
--- /dev/null
+++ b/sysdeps/fenrir/generic/sysdeps.cpp
@@ -0,0 +1,77 @@
+/*
+ * Copyright (c) 2026-present, SkillerRaptor
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "mlibc/tcb.hpp"
+#include <abi-bits/errno.h>
+#include <bits/ensure.h>
+#include <fenrir/syscall.hpp>
+#include <mlibc/all-sysdeps.hpp>
+#include <string.h>
+
+#define SYS_EXIT 1
+#define SYS_WRITE 2
+#define SYS_ALLOC 3
+#define SYS_FS 4
+
+#define STUB()                                                                                     \
+	({                                                                                             \
+		__ensure(!"STUB function was called");                                                     \
+		__builtin_unreachable();                                                                   \
+	})
+
+namespace mlibc {
+
+void Sysdeps<LibcPanic>::operator()() {
+	sysdep<LibcLog>("!!! mlibc panic !!!\n");
+	sysdep<Exit>(-1);
+	__builtin_trap();
+}
+
+void Sysdeps<LibcLog>::operator()(const char *msg) { sysdep<Write>(0, msg, strlen(msg), nullptr); }
+
+int Sysdeps<Isatty>::operator()(int) { return 0; }
+
+int Sysdeps<Write>::operator()(int, void const *buf, size_t size, ssize_t *) {
+	syscall(SYS_WRITE, buf, size);
+	return 0;
+}
+
+int Sysdeps<TcbSet>::operator()(void *ptr) {
+	syscall(SYS_FS, ptr);
+	return 0;
+}
+
+int Sysdeps<AnonAllocate>::operator()(size_t size, void **ptr) {
+	*ptr = (void *)syscall(SYS_ALLOC, size);
+	return 0;
+}
+
+int Sysdeps<AnonFree>::operator()(void *, unsigned long) { return 0; }
+
+int Sysdeps<Seek>::operator()(int, off_t, int, off_t *) { return ESPIPE; }
+
+void Sysdeps<Exit>::operator()(int status) {
+	syscall(SYS_EXIT, status);
+	__builtin_unreachable();
+}
+
+int Sysdeps<Close>::operator()(int) { STUB(); }
+
+int Sysdeps<FutexWake>::operator()(int *, bool) { STUB(); }
+
+int Sysdeps<FutexWait>::operator()(int *, int, timespec const *) { STUB(); }
+
+int Sysdeps<Read>::operator()(int, void *, unsigned long, long *) { STUB(); }
+
+int Sysdeps<Open>::operator()(const char *, int, unsigned int, int *) { STUB(); }
+
+int Sysdeps<VmMap>::operator()(void *, size_t, int, int, int, off_t, void **) { STUB(); }
+
+int Sysdeps<VmUnmap>::operator()(void *, size_t) { STUB(); }
+
+int Sysdeps<ClockGet>::operator()(int, time_t *, long *) { STUB(); }
+
+} // namespace mlibc
