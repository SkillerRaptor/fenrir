#!/bin/sh

name=mlibc-headers
version=0
revision=0

mlibc_commit='86ddc2a14ddacba41ec12f854289b3a929133ace'

tarball_url="https://github.com/SkillerRaptor/mlibc/archive/${mlibc_commit}.tar.gz"
tarball_sha256="a482eb6d1dd641c114dd95477f4fa554d2f88d7873aacce453fd1175560c2f5c"

configure() {
    meson setup \
        headers-build "${source_dir}" \
        --cross-file="${base_dir}/toolchains/${JINX_ARCH}-fenrir.ini" \
        --prefix="${prefix}" \
        -Dheaders_only=true
}

build() {
    ninja -C headers-build -j"${parallelism}"
}

package() {
    DESTDIR="${dest_dir}" ninja -C headers-build install
}
