#!/bin/sh

name=doomgeneric
version=0
revision=0
allow_network=yes

doomgeneric_commit='dcb7a8dbc7a16ce3dda29382ac9aae9d77d21284'

tarball_url="https://github.com/ozkl/doomgeneric/archive/${doomgeneric_commit}.tar.gz"
tarball_sha256="1bd3f7f26220494159a38d71f2847ec81b58d6bbd7c7c8d81b08993018001148"

deps="mlibc mlibc-headers"
hostdeps="gcc"

doom_wad_url="https://archive.org/download/wadarchive/DATA/5b.zip/5b%2F2e249b9c5133ec987b3ea77596381dc0d6bc1d%2F5b2e249b9c5133ec987b3ea77596381dc0d6bc1d.wad.gz"

configure() {
    wget -O ./DOOM1.WAD.gz "${doom_wad_url}"
    gunzip -f ./DOOM1.WAD.gz

    cp -rpf "${source_dir}"/. ./
    meson setup \
        build . \
        --cross-file="${base_dir}/toolchains/${JINX_ARCH}-fenrir.ini"
}

build() {
    ninja -C build -j"${parallelism}"
}

package() {
    mkdir -p ${dest_dir}/staging
    cp ./build/doomgeneric ${dest_dir}/staging
    cp ./DOOM1.WAD ${dest_dir}/staging
}
